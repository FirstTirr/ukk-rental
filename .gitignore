# ==========================================
# 1. DEPENDENCIES (Abaikan untuk Frontend & Backend)
# ==========================================
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# 2. NEXT.JS SPECIFIC (Disesuaikan jalurnya ke subfolder frontend)
# ==========================================
frontend/.next/
frontend/out/
frontend/next-env.d.ts
*.tsbuildinfo

# ==========================================
# 3. PRODUCTION & TESTING
# ==========================================
/build/
backend/build/
/coverage/

# ==========================================
# 4. ENVIRONMENT FILES (Sangat Penting! Jangan sampai bocor)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env*

# ==========================================
# 5. MISC & DEBUG (Sistem & Log)
# ==========================================
.DS_Store
*.pem
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*